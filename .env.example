# Environment variables for Gekko
# See sample-config.js for full configuration options

# Node environment: development, test, or production
NODE_ENV=development

# Server settings
HOST=localhost
PORT=3000

# Exchange API credentials (only required for live trading)
# Get these from your exchange account. Never commit real keys.
# Format: EXCHANGE_NAME_KEY=your_key, EXCHANGE_NAME_SECRET=your_secret
# Example for Binance:
# BINANCE_KEY=your_binance_api_key
# BINANCE_SECRET=your_binance_api_secret

# For paper trading / backtesting, no exchange keys are needed.